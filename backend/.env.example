# Servidor
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Base de Dados (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=valida_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Armazenamento (MinIO local — compatível com S3)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
AWS_S3_BUCKET=valida-files
AWS_S3_BUCKET_CERTIFICADOS=valida-certificados
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# Registro
LOG_LEVEL=info

# JWT — OBRIGATORIO. Gere um valor seguro: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
