# Servidor
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Base de Dados (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=valida_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Armazenamento (MinIO local — compatível com S3)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
AWS_S3_BUCKET=valida-files
AWS_S3_BUCKET_CERTIFICADOS=valida-certificados
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# Registro
LOG_LEVEL=info

# JWT — OBRIGATORIO. Gere um valor seguro: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Blockchain de documentos
# Dificuldade do proof of work (zeros hex no início do hash, 1–6)
BLOCKCHAIN_DIFICULDADE=3
# Chave Ed25519 do validador (PEM PKCS8, use 
 nas quebras de linha). Se vazio, é gerada em BLOCKCHAIN_ARQUIVO_CHAVE
BLOCKCHAIN_CHAVE_PRIVADA=
BLOCKCHAIN_ARQUIVO_CHAVE=.blockchain/validador.pem
# Âncoras de confiança opcionais: chaves públicas (base64, separadas por vírgula) e hash esperado do gênese
BLOCKCHAIN_VALIDADORES_CONFIAVEIS=
BLOCKCHAIN_HASH_GENESE=

# Hyperledger Fabric (opcional) — gere os caminhos com: fabric/rede/rede.sh env
FABRIC_HABILITADO=false
FABRIC_CANAL=valida
FABRIC_CHAINCODE=valida-documentos
FABRIC_MSP_ID=Org1MSP
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com
FABRIC_TLS_CERT_PATH=
FABRIC_CERT_PATH=
FABRIC_KEY_PATH=
FABRIC_INTERVALO_SINCRONIZACAO_MS=5000
# A cada N blocos da cadeia própria, o hash do bloco é ancorado no Fabric
FABRIC_CHECKPOINT_A_CADA=10
