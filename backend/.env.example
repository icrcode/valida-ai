# Servidor
NODE_ENV=development
PORT=3000

# Base de Dados (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=valida_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=valida-files
MINIO_USE_SSL=false

# Registro
LOG_LEVEL=info

# JWT (se necessário)
JWT_SECRET=sua-chave-secreta-aqui
JWT_EXPIRES_IN=7d
