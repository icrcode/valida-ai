# ─────────────────────────────────────────────────────────
# Arquivo: .env.production.example
# Copie para .env.prod no servidor EC2 e preencha os valores
# NUNCA commite o .env.prod no repositório
# ─────────────────────────────────────────────────────────

# Docker Hub (usado pelo docker-compose.prod.yml)
DOCKERHUB_USERNAME=seu-usuario-dockerhub

# ── Banco de Dados ────────────────────────────────────────
DB_USER=valida_user
DB_PASSWORD=TROQUE_POR_SENHA_FORTE
DB_NAME=valida_db

# ── Redis ─────────────────────────────────────────────────
REDIS_PASSWORD=TROQUE_POR_SENHA_FORTE

# ── AWS S3 ────────────────────────────────────────────────
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_S3_BUCKET=valida-balde-files
AWS_S3_BUCKET_CERTIFICADOS=valida-balde-certificados

# ── JWT ───────────────────────────────────────────────────
# Gere com: openssl rand -base64 64
JWT_SECRET=TROQUE_POR_STRING_ALEATORIA_LONGA
JWT_EXPIRES_IN=7d

# ── CORS (URL pública do frontend) ────────────────────────
# Exemplo: http://ec2-XX-XX-XX-XX.compute-1.amazonaws.com
# Ou seu domínio: https://app.validaai.com.br
CORS_ORIGIN=http://SEU_IP_OU_DOMINIO

# ── Logs ──────────────────────────────────────────────────
LOG_LEVEL=info

# ── Grafana (acesso somente via túnel SSH: ssh -L 3001:localhost:3001 usuario@servidor) ──
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=TROQUE_POR_SENHA_FORTE
