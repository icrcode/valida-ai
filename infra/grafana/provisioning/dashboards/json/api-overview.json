{
  "title": "Valida AI - API Overview",
  "uid": "valida-api-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": ["valida-ai", "api"],
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Taxa de requisições por segundo (por rota)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (rota) (rate(http_requests_total[5m]))",
          "legendFormat": "{{rota}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latência p95 (por rota)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, rota) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{rota}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Taxa de erros (status >= 500)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m]))",
          "legendFormat": "erros 5xx",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Memória do processo (RSS)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "process_resident_memory_bytes{job=\"valida-backend\"}",
          "legendFormat": "RSS",
          "refId": "A"
        }
      ]
    }
  ]
}
